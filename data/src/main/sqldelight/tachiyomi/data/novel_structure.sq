CREATE TABLE novel_layouts(
    manga_id INTEGER NOT NULL PRIMARY KEY,
    layout INTEGER NOT NULL,
    total_pages INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(manga_id) REFERENCES mangas (_id)
    ON DELETE CASCADE,
    CHECK (
        (layout = 2 AND total_pages >= 1) OR
        (layout IN (0, 1) AND total_pages = 0)
    )
);

CREATE TABLE novel_sections(
    _id INTEGER NOT NULL PRIMARY KEY,
    manga_id INTEGER NOT NULL,
    kind INTEGER NOT NULL,
    name TEXT NOT NULL,
    page_number INTEGER,
    path TEXT,
    cover TEXT,
    sort_order INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(manga_id) REFERENCES mangas (_id)
    ON DELETE CASCADE,
    UNIQUE(manga_id, kind, name),
    CHECK (
        (kind = 2 AND page_number >= 1 AND name = CAST(page_number AS TEXT)) OR
        (kind IN (0, 1) AND page_number IS NULL)
    )
);

CREATE INDEX novel_sections_manga_order_index
ON novel_sections(manga_id, sort_order);

CREATE TABLE novel_chapter_sections(
    chapter_id INTEGER NOT NULL PRIMARY KEY,
    section_id INTEGER NOT NULL,
    position INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(chapter_id) REFERENCES chapters (_id)
    ON DELETE CASCADE,
    FOREIGN KEY(section_id) REFERENCES novel_sections (_id)
    ON DELETE CASCADE
);

CREATE INDEX novel_chapter_sections_section_position_index
ON novel_chapter_sections(section_id, position);

CREATE TRIGGER novel_chapter_sections_same_manga
BEFORE INSERT ON novel_chapter_sections
BEGIN
    SELECT RAISE(ABORT, 'Chapter and section must belong to the same novel')
    WHERE (
        SELECT manga_id
        FROM chapters
        WHERE _id = new.chapter_id
    ) != (
        SELECT manga_id
        FROM novel_sections
        WHERE _id = new.section_id
    );
END;

upsertLayout:
INSERT INTO novel_layouts(manga_id, layout, total_pages)
VALUES (:mangaId, :layout, :totalPages)
ON CONFLICT(manga_id) DO UPDATE SET
    layout = excluded.layout,
    total_pages = excluded.total_pages;

deleteSectionsByMangaId:
DELETE FROM novel_sections
WHERE manga_id = :mangaId;

insertSection:
INSERT INTO novel_sections(manga_id, kind, name, page_number, path, cover, sort_order)
VALUES (:mangaId, :kind, :name, :pageNumber, :path, :cover, :sortOrder)
RETURNING _id;

insertChapterSection:
INSERT INTO novel_chapter_sections(chapter_id, section_id, position)
VALUES (:chapterId, :sectionId, :position);

getLayoutByMangaId:
SELECT *
FROM novel_layouts
WHERE manga_id = :mangaId;

getSectionsByMangaId:
SELECT *
FROM novel_sections
WHERE manga_id = :mangaId
ORDER BY sort_order, _id;

getChapterSectionsByMangaId:
SELECT
    novel_chapter_sections.chapter_id,
    novel_chapter_sections.section_id,
    novel_chapter_sections.position
FROM novel_chapter_sections
JOIN novel_sections
ON novel_sections._id = novel_chapter_sections.section_id
WHERE novel_sections.manga_id = :mangaId
ORDER BY novel_sections.sort_order, novel_chapter_sections.position;
