{
  "name": "tsundoku-js-runtime",
  "private": true,
  "version": "0.0.0",
  "description": "Headless React Native runtime hosting LNReader-compatible JS plugins.",
  "codegenConfig": {
    "name": "TsundokuJsRuntimeSpec",
    "type": "modules",
    "jsSrcsDir": "specs",
    "android": {
      "javaPackageName": "eu.kanade.tachiyomi.jsruntime.spec"
    }
  },
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "@noble/ciphers": "^2.2.0",
    "buffer": "^6.0.3",
    "cheerio": "1.0.0-rc.12",
    "crypto-browserify": "^3.12.1",
    "dayjs": "^1.11.21",
    "events": "^3.3.0",
    "html-entities": "^2.6.0",
    "htmlparser2": "^8.0.2",
    "protobufjs": "^8.7.1",
    "react": "19.2.8",
    "react-native": "0.86.0",
    "stream-browserify": "^3.0.0",
    "urlencode": "^2.0.0"
  },
  "//hermes-compiler": [
    "Transitive dependency of react-native, promoted to a direct one because pnpm's isolated",
    "node_modules only symlinks direct deps and the React Native Gradle plugin looks for hermesc at",
    "the literal path node_modules/hermes-compiler/hermesc/%OS-BIN%/ (PathUtils.kt:243).",
    "The version MUST equal HERMES_V1_VERSION_NAME in",
    "node_modules/react-native/sdks/hermes-engine/version.properties — js-runtime/build.gradle.kts",
    "fails the build if they diverge."
  ],
  "devDependencies": {
    "@babel/plugin-transform-export-namespace-from": "8.0.1",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/codegen": "0.86.0",
    "@react-native/gradle-plugin": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@types/node": "^26.1.1",
    "@types/react": "19.2.17",
    "hermes-compiler": "250829098.0.14",
    "typescript": "5.9.2"
  }
}
