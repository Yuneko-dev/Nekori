set -e
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Staged files, including deletions, so a delete still triggers its component.
STAGED="$(git diff --cached --name-only)"

# Detect components from staged paths.
IS_JS=0
IS_KOTLIN=0
IS_SQL=0
IS_READER=0
IS_I18N=0

if printf '%s\n' "$STAGED" | grep -qE '^js-runtime/'; then IS_JS=1; fi
if printf '%s\n' "$STAGED" | grep -qE '\.(kt|kts|xml)$'; then IS_KOTLIN=1; fi
if printf '%s\n' "$STAGED" | grep -qE '\.sqm?$'; then IS_SQL=1; fi
if printf '%s\n' "$STAGED" | grep -qE '^packages/reader/|^packages/videojs-bundle/|^app/tools/devtools-lite/|^app/tools/generate-shipped-js-licenses\.mjs$|^app/src/test/js/'; then IS_READER=1; fi
if printf '%s\n' "$STAGED" | grep -qE '/(strings|plurals)\.xml$'; then IS_I18N=1; fi

# Kotlin: Spotless. Mirrors the style job in kotlin-checks.yml.
# Full unit tests stay in CI; they need the Android SDK and are too slow here.
if [ "$IS_KOTLIN" -eq 1 ] || [ "$IS_SQL" -eq 1 ]; then
  if [ -z "$ANDROID_HOME" ] && [ -z "$ANDROID_SDK_ROOT" ] && [ -d "$HOME/Library/Android/sdk" ]; then
    export ANDROID_HOME="$HOME/Library/Android/sdk"
  fi
  if [ -z "$ANDROID_HOME" ] && [ -z "$ANDROID_SDK_ROOT" ] && [ ! -f "$ROOT/local.properties" ]; then
    echo "Android SDK not found (no ANDROID_HOME and no local.properties), skipping Kotlin checks. CI will enforce them."
  else
    echo "Kotlin: ./gradlew spotlessCheck"
    if [ "$IS_SQL" -eq 1 ]; then
      ./gradlew spotlessCheck verifySqlDelightMigration --continue
    else
      ./gradlew spotlessCheck --continue
    fi
  fi
fi

# js-runtime: lint-staged (format staged), type-check, lint, test:chapter.
# Mirrors js-runtime-checks.yml. format:check is skipped because
# lint-staged already formats staged files.
if [ "$IS_JS" -eq 1 ]; then
  echo "js-runtime: lint-staged, type-check, lint, test:chapter"
  if [ ! -d "$ROOT/js-runtime/node_modules" ]; then
    echo "js-runtime/node_modules missing, running bun install"
    bun install --frozen-lockfile
  fi
  (cd js-runtime && bunx lint-staged)
  (cd js-runtime && bun run type-check)
  (cd js-runtime && bun run lint)
  (cd js-runtime && bun run test:chapter)
fi

# Reader runtime: bun check (typecheck, lint, build, test) plus devtools
# dist check. Mirrors reader-checks.yml.
if [ "$IS_READER" -eq 1 ]; then
  echo "reader-runtime: bun run check"
  if [ ! -d "$ROOT/node_modules" ]; then
    echo "node_modules missing, running bun install"
    bun install --frozen-lockfile
  fi
  bun run --filter @nekori/reader check
  node app/tools/devtools-lite/test-dist.mjs
fi

# i18n: XML well-formedness. Mirrors lint-translations.yml.
if [ "$IS_I18N" -eq 1 ]; then
  echo "i18n: xmllint"
  if command -v xmllint >/dev/null 2>&1; then
    printf '%s\n' "$STAGED" | grep -E '/(strings|plurals)\.xml$' | while IFS= read -r f; do
      xmllint --noout "$f"
    done
  else
    echo "xmllint not found, skipping i18n XML check"
  fi
fi

# Docs-only or unmatched changes: no heavy checks to run.
if [ "$IS_JS" -eq 0 ] && [ "$IS_KOTLIN" -eq 0 ] && [ "$IS_SQL" -eq 0 ] && [ "$IS_READER" -eq 0 ] && [ "$IS_I18N" -eq 0 ]; then
  echo "No component checks matched staged files, skipping"
fi
